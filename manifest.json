{
  "manifest_version": 3,
  "name": "Himoya: AI Scam & Phishing Detector",
  "version": "5.5.0",
  "description": "Enterprise client-side security engine protecting Central Asian users from card drainers, OTP phishing, and malicious APKs.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Himoya AI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "src/utils/storage.js",
        "src/engine/normalizer.js",
        "src/engine/ahoCorasick.js",
        "src/engine/bloomFilter.js",
        "src/content/shadowUI.js",
        "src/content/contentScript.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/engine/rules.json"
      ],
      "matches": [
        "https://web.telegram.org/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}